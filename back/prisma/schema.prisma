generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Fase 11 (passo 11.1): usuarioId nullable de propósito — link criado
/// sem conta continua sendo um caso de uso de primeira classe (o produto
/// encurta link sem cadastro desde o dia um, ver "Segurança"), não um
/// estado inválido a ser migrado depois. Links antigos (de antes desta
/// fase) e os criados anonimamente continuam existindo com usuarioId
/// null indefinidamente.
model Link {
  id         String    @id @default(uuid())
  slug       String    @unique @db.VarChar(16)
  urlDestino String
  criadoEm   DateTime  @default(now())
  expiraEm   DateTime?
  ativo      Boolean   @default(true)
  usuarioId  String?
  usuario    Usuario?  @relation(fields: [usuarioId], references: [id])

  cliques           Clique[]
  cliquesDia        CliqueDia[]
  cliquesDiaOrigem  CliqueDiaPorOrigem[]
  cliquesDiaReferer CliqueDiaPorReferer[]

  // Sustenta a listagem "meus links" (GET /links, passo 11.3): filtra por
  // usuarioId e ordena por criadoEm desc — a mesma ordem do índice, sem
  // sort adicional.
  @@index([usuarioId, criadoEm])
}

/// nome: gap descoberto depois do passo 11.1 — "Tela - Entrar" mostra um
/// campo Nome no formulário de criar conta, mas o passo 11.1 seguiu à
/// risca a lista de campos do prompt original, que não incluía nome.
/// Resolvido em 2026-08-21 adicionando o campo (ver Log de Mudanças).
model Usuario {
  id        String   @id @default(uuid())
  nome      String   @db.VarChar(120)
  email     String   @unique
  senhaHash String
  criadoEm  DateTime @default(now())

  links Link[]
}

model Clique {
  id          String   @id @default(uuid())
  linkId      String
  link        Link     @relation(fields: [linkId], references: [id])
  quando      DateTime @default(now())
  pais        String?  @db.VarChar
  referer     String?  @db.VarChar
  dispositivo String?  @db.VarChar

  @@index([linkId])
  @@index([linkId, quando])
}

model CliqueDia {
  id     String   @id @default(uuid())
  linkId String
  link   Link     @relation(fields: [linkId], references: [id])
  dia    DateTime @db.Date
  total  Int

  @@unique([linkId, dia])
  @@index([linkId, dia])
}

/// Agregado por dimensão (dispositivo/país), alimentado pelo mesmo job de
/// agregação diária que popula CliqueDia — ver especulação na nota
/// "Dashboard": dimensões extras não cabiam em CliqueDia (só linkId+dia)
/// sem misturar o propósito do gráfico de linha com o das tabelas de
/// origem. `dispositivo` e `pais` são NOT NULL (sentinela "" para
/// "desconhecido") de propósito: um UNIQUE com coluna NULL não bloqueia
/// duplicatas no Postgres (NULL nunca é igual a NULL), o que quebraria a
/// idempotência do upsert para o grupo "sem essa informação".
model CliqueDiaPorOrigem {
  id          String   @id @default(uuid())
  linkId      String
  link        Link     @relation(fields: [linkId], references: [id])
  dia         DateTime @db.Date
  dispositivo String   @db.VarChar
  pais        String   @default("") @db.VarChar
  total       Int

  @@unique([linkId, dia, dispositivo, pais])
  @@index([linkId, dia])
}

/// Agregado por domínio de origem do referer — não pela URL completa
/// (cardinalidade alta demais: cada link compartilhado com parâmetro de
/// tracking diferente viraria uma linha nova). `referer` guarda o
/// hostname normalizado (ex.: "twitter.com"); "" é o sentinela para
/// "sem referer" (acesso direto), pelo mesmo motivo de NULL vs UNIQUE
/// explicado em CliqueDiaPorOrigem.
model CliqueDiaPorReferer {
  id      String   @id @default(uuid())
  linkId  String
  link    Link     @relation(fields: [linkId], references: [id])
  dia     DateTime @db.Date
  referer String   @default("") @db.VarChar
  total   Int

  @@unique([linkId, dia, referer])
  @@index([linkId, dia])
}

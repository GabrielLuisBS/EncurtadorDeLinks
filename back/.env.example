# Neon → dashboard do projeto → "Connect" → copie a "Connection string".
# Em produção use a connection string com pooler (host termina em
# "-pooler", porta 5432 continua igual) — o back roda como processo
# persistente no Render, não serverless/edge, mas o pooler evita esgotar
# as conexões diretas do Postgres se o Render escalar pra mais de uma
# instância. Precisa terminar em ?sslmode=require (Neon exige TLS).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.regiao.aws.neon.tech/linkly?sslmode=require"

# Upstash → dashboard do database → aba "Details" → bloco "Connect" →
# copie a URL rotulada "ioredis" (não a REST URL/token — o projeto usa o
# protocolo Redis padrão via ioredis, não a API REST do Upstash). Sempre
# rediss:// (TLS), nunca redis://: Upstash não aceita conexão sem TLS.
REDIS_URL="rediss://default:senha@endpoint.upstash.io:6379"

PORT=3333
PUBLIC_BASE_URL="http://localhost:3333"
# Origem do front, liberada no CORS. Ajuste se o Vite subir em outra porta
# (ele incrementa sozinho quando 5173 já está em uso).
FRONT_URL="http://localhost:5173"
